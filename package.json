{
  "name": "@oritwoen/ciphers",
  "version": "0.1.1",
  "type": "module",
  "description": "Unified educational and puzzle cipher library for agents",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "ch": "./dist/cli.mjs"
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./packages/omp/extensions/ciphers.ts"
    ]
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.omp.json",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@oh-my-pi/omptype": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12",
    "@types/node": "latest",
    "obuild": "^0.4.36",
    "tsx": "^4.22.4",
    "typebox": "^1.1.39",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
