{
  "name": "@agntn/ciphers",
  "version": "0.7.0",
  "description": "Unified educational and puzzle cipher library for agents",
  "homepage": "https://ciphers.agntn.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agntn/ciphers"
  },
  "bin": {
    "ciphers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "extensions/omp",
    "extensions/pi",
    "extensions/shared"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./aes": {
      "types": "./dist/aes.d.mts",
      "import": "./dist/aes.mjs"
    },
    "./chacha": {
      "types": "./dist/chacha.d.mts",
      "import": "./dist/chacha.mjs"
    },
    "./salsa": {
      "types": "./dist/salsa.d.mts",
      "import": "./dist/salsa.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "docs": "pnpm --dir docs dev",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "vp lint --tsconfig ./tsconfig.lint.json && vp fmt --check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.omp.json && tsc --noEmit -p tsconfig.lint.json",
    "test": "vp test",
    "test:packed": "node test/eval-packed.mjs",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "@agntn/compressions": "catalog:deps",
    "@agntn/encodings": "catalog:deps",
    "@agntn/hashes": "catalog:deps",
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "changelogen": "catalog:dev",
    "obuild": "catalog:dev",
    "tsx": "catalog:dev",
    "typebox": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "omp": {
    "extensions": [
      "./extensions/omp/ciphers.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/*.ts"
    ],
    "image": "https://ciphers.agntn.dev/image.png"
  }
}
