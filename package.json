{
  "name": "@agntn/ciphers",
  "version": "0.1.1",
  "description": "Unified educational and puzzle cipher library for agents",
  "bin": {
    "ciphers": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.omp.json",
    "test": "vp test",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && changelogen --release --push"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@oh-my-pi/omptype": "17.2.12",
    "@oh-my-pi/pi-coding-agent": "17.2.12",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "obuild": "^0.4.36",
    "tsx": "^4.22.4",
    "typebox": "^1.1.39",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@10.33.4",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/ciphers.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
