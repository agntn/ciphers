{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": { "#mcp": ["./src/mcp.ts"] }
  },
  "include": [
    "build.config.ts",
    "vite.config.ts",
    "src/**/*.ts",
    "packages/**/*.ts",
    "test/**/*.ts",
    "test/**/*.mjs"
  ]
}
